      "expr": "(B,T,C)@(C,H)",
      "result": "(4, 8, 16)"
    },
    {
      "case": "linear layer nn.Linear(C,H)",
      "expr": "Linear(C\u2192H) on (B,T,C)",
      "result": "(4, 8, 16)"
    },
    {
      "case": "transpose last two dims",
      "expr": "(B,T,C).T",
      "result": "(4, 32, 8)"
    },
    {
      "case": "broadcast add bias",
      "expr": "(B,T,C)+(C)",
      "result": "(4, 8, 32)"
    },
    {
      "case": "logits over vocab",
      "expr": "(B,T,C)@(C,V)",
      "result": "(4, 8, 65)"
